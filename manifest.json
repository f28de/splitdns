{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "short_name": "SplitDNS",
  "version": "1.0.5",
  "description": "__MSG_appDesc__",
  "default_locale": "zh_CN",
  "minimum_chrome_version": "109",
  "homepage_url": "https://github.com/splitdns/splitdns-edge",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "__MSG_appName__",
    "default_popup": "src/ui/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/ui/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "activeTab"
  ],
  "optional_permissions": [
    "proxy"
  ],
  "host_permissions": [
    "https://dns.alidns.com/*",
    "https://doh.pub/*",
    "https://cloudflare-dns.com/*",
    "https://dns.google/*",
    "https://dns.quad9.net/*",
    "https://doh.360.cn/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "externally_connectable": {
    "ids": []
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "builtin-ads",
        "enabled": false,
        "path": "rules/builtin-ads.json"
      }
    ]
  }
}
